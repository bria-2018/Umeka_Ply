# Copy to .env.local and fill in. All values are optional; the site works without them.

# Public URL of the live site (used for canonical URLs, sitemap and Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.umekainternational.in

# Form endpoint that receives enquiry submissions as JSON (POST).
# Works with Formspree, Web3Forms, Getform, a Google Apps Script web app,
# or your own serverless function. If empty, the site runs in "demo mode":
# the form validates, shows a success message, and offers a WhatsApp hand-off.
NEXT_PUBLIC_FORM_ENDPOINT=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
